[Desktop Entry]
Name=Zyntheo IDE
Comment=Intelligence in Every Line.
GenericName=Text Editor
Exec=zyntheo %F
Icon=zyntheo
Type=Application
StartupNotify=false
StartupWMClass=Zyntheo
Categories=TextEditor;Development;IDE;
MimeType=application/x-zyntheo-workspace;
Keywords=zyntheo;
Actions=new-empty-window;

[Desktop Action new-empty-window]
Name=New Empty Window
Name[de]=Neues leeres Fenster
Name[es]=Nueva ventana vacía
Name[fr]=Nouvelle fenêtre vide
Name[it]=Nuova finestra vuota
Name[ja]=新しい空のウィンドウ
Name[ko]=새 빈 창
Name[ru]=Новое пустое окно
Name[zh_CN]=新建空窗口
Name[zh_TW]=開新空視窗
Exec=zyntheo --new-window %F
Icon=zyntheo
